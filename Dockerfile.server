FROM rust:1.85-slim

WORKDIR /workspace

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    sqlite3 \
    libsqlite3-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY . .

EXPOSE 3001

CMD ["cargo", "run", "-p", "bounceback-server"]
